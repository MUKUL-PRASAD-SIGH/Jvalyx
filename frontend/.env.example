# Copy to .env (git-ignored) and fill in.
# NASA FIRMS MAP_KEY — https://firms.modaps.eosdis.nasa.gov/api/map_key
# Used client-side by src/firms/data/firmsClient.ts to pull live NRT active-fire
# data for India. If unset, the app falls back to a bundled dataset, then to
# representative synthetic India data.
VITE_FIRMS_MAP_KEY=

# CARTO Basemaps API Key — for authenticated CARTO raster basemaps
VITE_CARTO_API_KEY=

# Backend API URL
VITE_API_BASE_URL=http://localhost:8000
